{
  "description": "Gives every subagent the style rules, and warns when a written or newly created file or function exceeds the general-code-style size caps",
  "hooks": {
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-rules.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/check-size.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/check-new-files.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
