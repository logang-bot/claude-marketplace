{
  "description": "Warns when a written file or function exceeds the general-code-style size caps",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/check-size.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
