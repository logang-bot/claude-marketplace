{
  "description": "Reminds about docs/ when code changed without documentation",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/docs-reminder.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
